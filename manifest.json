{
  "manifest_version": 3,
  "name": "RefRunner Toolkit",
  "version": "2026.10.5.2",
  "version_name": "2026.10.05.02",
  "description": "Check a selected reference list in RefRunner, or jump from a page's DOI or OpenAlex ID to OpenAlex, Crossref, DataCite, and Scholar.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["https://www.refrunner.com/*"],
  "optional_host_permissions": ["https://localhost:5173/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RefRunner Toolkit",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Open the RefRunner Toolkit popup"
    },
    "openalex-api": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Open the OpenAlex API record for this page"
    },
    "send-refrunner": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Send the selection, or this page's DOI, to RefRunner"
    }
  }
}
